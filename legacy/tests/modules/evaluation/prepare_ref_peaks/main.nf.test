nextflow_process {
    name "PrepareReferencePeaks"
    script "../../../../modules/evaluation/prepare_ref_peaks/main.nf"
    process "PrepareReferencePeaks"

    test("Extracts TSS and TTS from GTF") {

        when {
            params {
                test_data_dir = "${projectDir}/tests/data"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        'test_set',
                        'sample1',
                        'pre-aligned',
                        'chr-test',
                        file("${params.test_data_dir}/tiny_annotation.gtf")
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out.ref_peaks.size() == 1

            def result = process.out.ref_peaks[0]
            assert result[0] == 'test_set'
            assert result[1] == 'sample1'
            assert result[2] == 'pre-aligned'
            assert result[3] == 'chr-test'

            // TSS bed (index 4) and TTS bed (index 5) should be non-empty
            def tss_file = path(result[4])
            def tts_file = path(result[5])
            assert tss_file.exists()
            assert tts_file.exists()
            assert tss_file.readLines().size() > 0
            assert tts_file.readLines().size() > 0

            // Should have entries for our transcripts (some may be deduplicated)
            def tss_lines = tss_file.readLines()
            def tts_lines = tts_file.readLines()
            assert tss_lines.size() >= 5  // at least one per gene after dedup
            assert tts_lines.size() >= 5

            // All entries should be on chr_test
            tss_lines.each { line ->
                assert line.startsWith("chr_test\t")
            }
            tts_lines.each { line ->
                assert line.startsWith("chr_test\t")
            }
        }
    }

    test("Output follows naming convention") {

        when {
            params {
                test_data_dir = "${projectDir}/tests/data"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        'test_set',
                        'sampleA',
                        'minimap2',
                        'full_genome',
                        file("${params.test_data_dir}/tiny_annotation.gtf")
                    )
                )
                """
            }
        }

        then {
            assert process.success
            def result = process.out.ref_peaks[0]
            assert result[4].toString().contains('sampleA_minimap2_full_genome_ref_tss.bed')
            assert result[5].toString().contains('sampleA_minimap2_full_genome_ref_tts.bed')
        }
    }
}
