                  "properties": {
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "all": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "fsm": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                },
                "exons": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "edges",
                    "all",
                    "fsm"
                  ],
                  "properties": {
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "all": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "fsm": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
