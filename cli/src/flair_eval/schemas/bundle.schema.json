                  "properties": {
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "counts": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            },
            "by_category": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "length",
                "exons"
              ],
              "properties": {
                "length": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "edges",
                    "counts"
                  ],
                  "properties": {
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "number"
