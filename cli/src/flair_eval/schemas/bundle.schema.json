      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "label": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "flair": {
      "type": "object",
      "required": [
        "source",
        "requested",
        "version"
      ],
      "properties": {
        "source": {
          "enum": [
            "release",
            "git",
            "env",
            "container"
          ]
        },
        "requested": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "version",
        "created"
      ],
      "properties": {
