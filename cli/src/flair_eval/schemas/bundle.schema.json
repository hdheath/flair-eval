                "fsm_refs_multi": {
                  "type": "integer",
                  "minimum": 0
                },
                "fsm_ism_isoforms": {
                  "type": "integer",
                  "minimum": 0
                },
                "fsm_ism_refs": {
                  "type": "integer",
                  "minimum": 0
                },
                "fsm_ism_refs_multi": {
                  "type": "integer",
