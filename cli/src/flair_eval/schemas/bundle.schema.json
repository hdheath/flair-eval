          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "string"
        },
        "launch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "type": "object"
