          "required": [
            "scorer",
            "provisional",
            "sets",
            "ends",
            "pairs"
          ],
          "properties": {
            "scorer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "script",
                "source",
                "md5",
                "window",
                "regions"
              ],
              "properties": {
                "script": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "md5": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "window": {
                  "type": "integer",
                  "minimum": 0
                },
                "regions": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "provisional": {
              "type": "boolean"
            },
            "sets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "end",
                  "assay",
                  "file",
                  "path",
                  "md5",
                  "provisional"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
