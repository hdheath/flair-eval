            }
          }
        },
        "transcript_length": {
          "type": "object",
          "required": [
            "edges",
            "counts"
          ],
          "properties": {
            "edges": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "counts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "exon_length": {
          "type": "object",
          "required": [
            "edges",
            "counts"
          ],
          "properties": {
            "edges": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "counts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
