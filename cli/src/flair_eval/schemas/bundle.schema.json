      "properties": {
        "FSM": {
          "type": "integer",
          "minimum": 0
        },
        "ISM": {
          "type": "integer",
          "minimum": 0
        },
        "NIC": {
          "type": "integer",
          "minimum": 0
        },
        "NNC": {
          "type": "integer",
          "minimum": 0
        },
        "genic": {
          "type": "integer",
          "minimum": 0
        },
        "genic_intron": {
          "type": "integer",
          "minimum": 0
        },
        "antisense": {
          "type": "integer",
          "minimum": 0
        },
        "intergenic": {
          "type": "integer",
          "minimum": 0
        },
        "fusion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fsm_subcategories": {
      "type": "object",
