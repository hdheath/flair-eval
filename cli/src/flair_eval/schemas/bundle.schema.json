        "novel": {
          "type": "integer",
          "minimum": 0
        },
        "motif_checked": {
          "type": "boolean"
        }
      }
    },
    "histograms": {
      "type": "object",
      "required": [
        "isoforms_per_gene",
        "transcript_length",
        "exon_length",
        "exons_per_isoform"
