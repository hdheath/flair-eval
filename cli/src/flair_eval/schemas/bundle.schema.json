        "genes": {
          "type": "integer",
          "minimum": 0
        },
        "loci": {
          "type": "integer",
          "minimum": 0
        },
        "mono_exon": {
          "type": "integer",
          "minimum": 0
        },
        "multi_exon": {
          "type": "integer",
          "minimum": 0
        },
        "ref_transcripts_total": {
          "type": "integer",
          "minimum": 0
        },
        "ref_transcripts_fsm": {
          "type": "integer",
          "minimum": 0
        },
        "ref_transcripts_cim": {
          "type": "integer",
          "minimum": 0
