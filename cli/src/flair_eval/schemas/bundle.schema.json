                  "tes_set": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "isoforms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "unique_pairs": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "both_hit": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "both_hit_raw": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "precision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "naive_precision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "structure_qc": {
          "type": "object",
          "description": "CONTRACTS section 13: SQANTI3-style structure QC (bin/flair_eval_lib/structure_qc.py); canonical/rts/priming need the genome, junction_support the sample's junctions file, sr_junction_support the sample's sr_junctions file (A45), priming.by_coding productivity",
