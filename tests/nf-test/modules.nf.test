// Process tests with a fake adapter on PATH (via conda_prefix), checking what core passes to
// bin/flair_adapter.py (docs/CONTRACTS.md section 2).
nextflow_process {

    name "ASSEMBLE passes contract arguments"
    script "modules/assemble/main.nf"
    process "ASSEMBLE"

    test("run args with quotes, reads and regions reach the adapter") {
        when {
            process {
                """
                def d = "${projectDir}/tests/nf-test/inputs"
                input[0] = [
                    [id: 's/r', sample: 's', run_id: 'r', run: [id: 'r', transcriptome_args: "--stringent --note it's here"]],
                    file("\${d}/sampleC.bam"), file("\${d}/sampleC.bam.bai"), file("\${d}/sampleA.fastq"),
                    file("\${d}/genome.fa"), file("\${d}/annotation.gtf"),
                    [conda_prefix: "\${d}/fake_flair_prefix", container: null],
                ]
                input[1] = file("\${d}/regions.bed")
                """
            }
        }
        then {
            assert process.success
            def argv = path("${process.out.dir[0][1]}/argv.json").json
            assert argv[0] == 'assemble'
            def opt = { String k -> argv[argv.indexOf(k) + 1] }
            assert opt('--args') == "--stringent --note it's here"
            assert opt('--bam') == 'sampleC.bam'
            assert opt('--reads') == 'sampleA.fastq'
            assert opt('--regions') == 'regions.bed'
            assert opt('--threads') ==~ /\d+/
            assert opt('--out') == 'assemble'
        }
    }

    test("BAM-only sample: no --reads, no --regions") {
        when {
            process {
                """
                def d = "${projectDir}/tests/nf-test/inputs"
                input[0] = [
                    [id: 's/r', sample: 's', run_id: 'r', run: [id: 'r', transcriptome_args: '']],
                    file("\${d}/sampleC.bam"), file("\${d}/sampleC.bam.bai"), [],
                    file("\${d}/genome.fa"), file("\${d}/annotation.gtf"),
                    [conda_prefix: "\${d}/fake_flair_prefix", container: null],
                ]
                input[1] = []
                """
            }
        }
        then {
            assert process.success
            def argv = path("${process.out.dir[0][1]}/argv.json").json
            assert !argv.contains('--reads')
            assert !argv.contains('--regions')
            assert argv[argv.indexOf('--args') + 1] == ''
        }
    }
}
