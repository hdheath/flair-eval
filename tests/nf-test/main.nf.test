// Pipeline-level stub tests: run with  nf-test test -c tests/nf-test/nf-test.config
nextflow_pipeline {

    name "flair-eval v2 (stub)"
    script "main.nf"
    options "-stub"

    test("file mode: samples.csv x runs.yaml gives one bundle per job and a report") {
        when {
            params {
                input   = "${projectDir}/tests/nf-test/inputs/samples.csv"
                runs    = "${projectDir}/tests/nf-test/inputs/runs.yaml"
                regions = "${projectDir}/tests/nf-test/inputs/regions.bed"
                outdir  = "$outputDir"
            }
        }
        then {
            assert workflow.success
            def jobs = ['sampleA', 'sampleC'].collectMany { s -> ['flair-3.0.1', 'flair-dev', 'dev-own-align'].collect { r -> "${s}/${r}" } }
            jobs.each { j ->
                def b = "$outputDir/bundles/${j}"
                ['bundle.json', 'isoforms.bed', 'isoforms.gtf', 'tables/isoforms.tsv', 'tables/categories.tsv',
                 'provenance/flair_env.json', 'provenance/adapter_assemble.json', 'provenance/trace.tsv'].each { f ->
                    assert path("${b}/${f}").exists() : "missing ${b}/${f}"
                }
                def bj = path("${b}/bundle.json").json
                assert bj.schema == 'flair-eval/bundle/1'
                assert "${bj.sample}/${bj.run_id}" == j
                assert bj.compute.keySet() == ['cpu_hours', 'peak_rss_gb', 'wall_minutes'] as Set
                assert bj.pipeline.version && bj.pipeline.created
                assert bj.inputs.regions.endsWith('regions.bed')
                // A12: core records the original absolute paths, not PREP_REFERENCE's cut copy
                assert bj.inputs.genome == "${projectDir}/tests/nf-test/inputs/genome.fa"
                assert bj.inputs.gtf == "${projectDir}/tests/nf-test/inputs/annotation.gtf"
                assert bj.inputs.reference_cut_to_regions == true
                def trace = path("${b}/provenance/trace.tsv").readLines()
                assert trace[0].split('\t') as List == ['task_id', 'name', 'status', 'exit', 'realtime', '%cpu', 'peak_rss', 'rss', 'duration']
                assert trace.drop(1).every { l -> l.contains("(${j})") && l.split('\t')[2] == 'COMPLETED' }
            }
            // sections (CONTRACTS section 8): quant and productivity written by BUNDLE
            def q = path("$outputDir/bundles/sampleA/flair-3.0.1/bundle.json").json.sections
            // A19: built by flair_eval_lib.sections; A21: input copied from adapter_log.json
            assert q.quant.isoforms_quantified == 2
            assert q.quant.reads_assigned == 4
            assert q.quant.cpm_hist.edges.size() == q.quant.cpm_hist.counts.size()
            assert q.quant.cpm_hist.counts.sum() == 2
            assert q.quant.input == 'reads'
            assert q.productivity.class_counts == [NGO: 1, PRO: 1]
            // A17: run_index = position in runs.yaml; A18: genes.tsv published
            ['flair-3.0.1': 0, 'flair-dev': 1, 'dev-own-align': 2].each { rid, i ->
                assert path("$outputDir/bundles/sampleC/${rid}/bundle.json").json.run_index == i
                assert path("$outputDir/bundles/sampleC/${rid}/tables/genes.tsv").exists()
            }
            assert !path("$outputDir/bundles/sampleA/flair-dev/bundle.json").json.sections.containsKey('quant')
            // quantify: false for flair-dev; productivity: false for dev-own-align
            assert !path("$outputDir/bundles/sampleA/flair-dev/counts.tsv").exists()
            assert path("$outputDir/bundles/sampleA/flair-dev/productivity.tsv").exists()
            assert path("$outputDir/bundles/sampleA/dev-own-align/counts.tsv").exists()
            assert !path("$outputDir/bundles/sampleA/dev-own-align/productivity.tsv").exists()
            assert path("$outputDir/bundles/sampleA/dev-own-align/provenance/adapter_align.json").exists()
            assert path("$outputDir/bundles/sampleA/flair-dev/bundle.json").json.label == 'FLAIR dev'
            assert path("$outputDir/bundles/sampleA/flair-dev/bundle.json").json.tags == [branch: 'dev']
            // one FLAIR_ENV per distinct source (3.0.1 doubles as align_flair; dev shared by 2 runs)
            def names = workflow.trace.tasks().collect { t -> t.name }
            assert names.count { n -> n.contains('FLAIR_EVAL:FLAIR_ENV') } == 2
            // shared align only for sampleA (sampleC has a BAM); own align for both samples
            assert names.count { n -> n.contains('FLAIR_EVAL:ALIGN_SHARED') } == 1
            assert names.count { n -> n.contains('FLAIR_EVAL:ALIGN_OWN') } == 2
            assert names.count { n -> n.contains('FLAIR_EVAL:BUNDLE') } == 6
            // --regions: one PREP_REFERENCE for the one distinct genome + GTF
            assert names.count { n -> n.contains('FLAIR_EVAL:PREP_REFERENCE') } == 1
            def html = path("$outputDir/report/report.html").text
            assert html.count('bundle.json') == 6
            // A5: first run is the default baseline; bundles reach the report in run order
            assert html.contains('--baseline flair-3.0.1')
            assert html.indexOf('/flair-3.0.1/bundle.json') < html.indexOf('/flair-dev/bundle.json')
            assert html.indexOf('/flair-dev/bundle.json') < html.indexOf('/dev-own-align/bundle.json')
            assert path("$outputDir/pipeline_info/params.json").json.input.endsWith('samples.csv')
        }
    }

    test("one-command mode: --reads/--genome/--gtf with --flair tokens") {
        when {
            params {
                reads      = "${projectDir}/tests/nf-test/inputs/sampleB.fq.gz"
                genome     = "${projectDir}/tests/nf-test/inputs/genome.fa"
                gtf        = "${projectDir}/tests/nf-test/inputs/annotation.gtf"
                flair      = "3.0.1,dev,git:https://github.com/someone/flair.git@feature/x,container:docker://quay.io/biocontainers/flair:2.0.0--pyhdfd78af_0"
                flair_args = "--stringent"
                baseline   = "flair-dev"
                outdir     = "$outputDir"
            }
        }
        then {
            assert workflow.success
            ['flair-3.0.1', 'flair-dev', 'flair-feature-x', 'ctr-flair'].each { r ->
                assert path("$outputDir/bundles/sampleB/${r}/bundle.json").exists()
                assert path("$outputDir/bundles/sampleB/${r}/provenance/adapter_assemble.json").json.args == '--stringent'
            }
            def html = path("$outputDir/report/report.html").text
            assert html.contains('--baseline flair-dev')
            assert html.count('bundle.json') == 4
        }
    }

    test("one-command mode with --bam and --sample skips the shared align") {
        when {
            params {
                bam    = "${projectDir}/tests/nf-test/inputs/sampleC.bam"
                genome = "${projectDir}/tests/nf-test/inputs/genome.fa"
                gtf    = "${projectDir}/tests/nf-test/inputs/annotation.gtf"
                sample = "mysample"
                flair  = "3.0.1"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/bundles/mysample/flair-3.0.1/bundle.json").exists()
            assert path("$outputDir/bundles/mysample/flair-3.0.1/bundle.json").json.inputs.reference_cut_to_regions == false
            // A6/A7: no reads, but QUANTIFY still runs from the BAM
            assert path("$outputDir/bundles/mysample/flair-3.0.1/counts.tsv").exists()
            def names = workflow.trace.tasks().collect { t -> t.name }
            assert !names.any { n -> n.contains('ALIGN_SHARED') }
            assert names.any { n -> n.contains('QUANTIFY') }
        }
    }

    test("--bundles adds earlier bundles to the report") {
        when {
            params {
                reads   = "${projectDir}/tests/nf-test/inputs/sampleA.fastq"
                genome  = "${projectDir}/tests/nf-test/inputs/genome.fa"
                gtf     = "${projectDir}/tests/nf-test/inputs/annotation.gtf"
                flair   = "3.0.1"
                bundles = "${projectDir}/tests/nf-test/inputs/prior_bundles"
                outdir  = "$outputDir"
            }
        }
        then {
            assert workflow.success
            def html = path("$outputDir/report/report.html").text
            assert html.contains('prior/p1/prior_bundles')
            assert html.count('bundle.json') == 2
        }
    }

    test("--report_only builds the report from --bundles and runs no FLAIR job") {
        when {
            params {
                report_only  = true
                bundles      = "${projectDir}/tests/nf-test/inputs/prior_bundles/*"
                report_title = "Old runs"
                outdir       = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 1
            def html = path("$outputDir/report/report.html").text
            assert html.contains('<h1>Old runs</h1>')
            assert html.contains('prior/p1/sampleP/flair-old/bundle.json')
            assert !path("$outputDir/bundles").exists()
        }
    }
}
