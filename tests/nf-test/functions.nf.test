// Unit tests for input parsing. The --flair token cases are the same as
// cli/tests/test_tokens.py, so core and the pip CLI stay in step (CONTRACTS section 7, A1).
nextflow_function {

    name "input parsing functions"
    script "subworkflows/inputs/main.nf"

    test("parseToken: CONTRACTS token table (cli test_contract_table)") {
        function "parseTokenEach"
        when { function { """
            input[0] = [
                '3.0.1', 'release:3.0.1', 'dev', 'main', 'git:ted-port',
                'git:https://github.com/me/flair@my-branch',
                'env:/path/to/conda/envs/flair-3.0.1',
                'container:docker://quay.io/biocontainers/flair:3.0.1--pyhdfd78af_0',
                'container:/images/flair.sif',
            ]
        """ } }
        then {
            def G = 'https://github.com/BrooksLabUCSC/flair'
            def expected = [
                [[release: '3.0.1'], 'flair-3.0.1'],
                [[release: '3.0.1'], 'flair-3.0.1'],
                [[git: G, ref: 'dev'], 'flair-dev'],
                [[git: G, ref: 'main'], 'flair-main'],
                [[git: G, ref: 'ted-port'], 'flair-ted-port'],
                [[git: 'https://github.com/me/flair', ref: 'my-branch'], 'flair-my-branch'],
                [[env: '/path/to/conda/envs/flair-3.0.1'], 'env-flair-3.0.1'],
                [[container: 'docker://quay.io/biocontainers/flair:3.0.1--pyhdfd78af_0'], 'ctr-flair'],
                [[container: '/images/flair.sif'], 'ctr-flair.sif'],
            ]
            assert function.success
            function.result.eachWithIndex { r, i ->
                assert !r.error : "unexpected error for ${r.token}: ${r.error}"
                assert [r.flair, r.id] == expected[i] : "token ${r.token}"
            }
        }
    }

    test("parseToken: open details (cli test_open_details)") {
        function "parseTokenEach"
        when { function { """
            input[0] = [
                'git:git@github.com:me/flair.git@abc123',
                'git:/home/me/flair@dev',
                'git:feature/ends',
                'env:/x/myenv/',
                'container:docker://org/flair@sha256:abcd',
                'container:docker://flair:3.0.1',
                '  2.2.0 ',
                'release:v3',
            ]
        """ } }
        then {
            def G = 'https://github.com/BrooksLabUCSC/flair'
            def expected = [
                [[git: 'git@github.com:me/flair.git', ref: 'abc123'], 'flair-abc123'],
                [[git: '/home/me/flair', ref: 'dev'], 'flair-dev'],
                [[git: G, ref: 'feature/ends'], 'flair-feature-ends'],
                [[env: '/x/myenv/'], 'env-myenv'],
                [[container: 'docker://org/flair@sha256:abcd'], 'ctr-flair'],
                [[container: 'docker://flair:3.0.1'], 'ctr-flair'],
                [[release: '2.2.0'], 'flair-2.2.0'],
                [[release: 'v3'], 'flair-v3'],
            ]
            function.result.eachWithIndex { r, i ->
                assert !r.error : "unexpected error for ${r.token}: ${r.error}"
                assert [r.flair, r.id] == expected[i] : "token ${r.token}"
            }
        }
    }

    test("parseToken: bad tokens (cli test_bad_tokens, test_unknown_word_suggests_git)") {
        function "parseTokenEach"
        when { function { """
            input[0] = ['', '  ', 'master', 'release:', 'git:', 'env:', 'container:',
                        'git:https://github.com/me/flair', 'git:git@github.com:me/flair.git', 'env:/']
        """ } }
        then {
            function.result.each { r -> assert r.error : "expected an error for '${r.token}'" }
            assert function.result[2].error.contains('git:master')
            assert function.result[0].error.contains('stray comma')
        }
    }

    test("quickRuns: list, duplicates, stray comma, flair_args (cli test_parse_tokens_*)") {
        function "quickRunsCheck"
        when { function { """
            input[0] = ['3.0.1,dev', '3.0.1,release:3.0.1', '3.0.1,,dev', '']
            input[1] = '--stringent'
        """ } }
        then {
            def r = function.result
            assert r[0].ids == ['flair-3.0.1', 'flair-dev']
            assert r[0].args == ['--stringent', '--stringent']
            assert r[0].errors == []
            assert r[1].errors.any { e -> e.contains('both give run id') && e.contains('runs.yaml') }
            assert r[2].errors.any { e -> e.contains('stray comma') }
            assert r[3].errors.any { e -> e.contains('--flair is empty') }
        }
    }

    test("stripReadExtensions") {
        function "stripReadExtensions"
        when { function { """
            input[0] = 'A549.ccs.fastq.gz'
        """ } }
        then { assert function.result == 'A549.ccs' }
    }

    test("splitCsvLine: quotes and escaped quotes") {
        function "splitCsvLine"
        when { function { """
            input[0] = 's1,"a,b","x""y",,z'
        """ } }
        then { assert function.result == ['s1', 'a,b', 'x"y', '', 'z'] }
    }
}
