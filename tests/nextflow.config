// Test-specific Nextflow configuration
// Used by nf-test for module and subworkflow tests

params {
    test_data_dir  = "${projectDir}/tests/data"
    outdir         = "${outputDir}"
    test_name      = 'nf_test'
    input          = null
    params_file    = null

    // Conda environment paths (mirrors nextflow.config defaults)
    conda_flair    = '/private/home/hdheath/miniforge3/envs/flair-dev'
    conda_analysis = '/private/home/hdheath/miniforge3/envs/nextflow_env'
    conda_bambu    = '/private/home/hdheath/miniforge3/envs/bambu'
    conda_isoquant = '/private/home/hdheath/miniforge3/envs/isoquant'
}

process {
    executor = 'local'
    memory   = '4 GB'
    cpus     = 1
    time     = '30m'
    conda    = params.conda_flair
}

conda {
    enabled = true
}
