// =============================================================================
// Nextflow configuration for FLAIR evaluation pipeline
// =============================================================================

// Pipeline metadata
manifest {
    name            = 'brookslab/flair-eval'
    author          = 'Brooks Lab'
    description     = 'Evaluation pipeline for long-read RNA-seq isoform assemblers'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// ---------------------------------------------------------------------------
// Global parameters
// ---------------------------------------------------------------------------
params {
    // Required inputs
    input       = null   // Samplesheet CSV with dataset definitions
    params_file = null   // JSON config with align/partition/transcriptome mode parameters
    test_name   = 'flair_test_suite'  // Test name for output organization
    outdir      = "results/${params.test_name}" // Base output directory (grouped by test_name)

    // Feature flags
    run_firstpass_comparison = false  // Set to true to enable firstpass vs final end-precision comparison
    lightweight_test_profile = false  // Internal flag used by the low-resource `test` profile

    // Optional files for partition process
    cage_peaks     = null
    drna_peaks = null
    junctions      = null
    target_regions = null
    a549_star_sj   = '/private/groups/brookslab/tswon/brooks_berger_collab/CCLE_depmap/fastq_celllines/bam_files_step4_20260324/A549_CCLE.SJ.out.tab'
    wtc11_star_sj  = '/private/groups/brookslab/cafelton/lrgasp-wtc11/WTC11_all.SJ.out.tab'

    // Conda environment paths -- override via -profile or command-line
    conda_flair    = '/private/home/hdheath/miniforge3/envs/flair4'
    conda_analysis = '/private/home/hdheath/miniforge3/envs/nextflow_env'
    conda_bambu    = '/private/home/hdheath/miniforge3/envs/bambu'
    conda_isoquant = '/private/home/hdheath/miniforge3/envs/isoquant'
    conda_isoseq   = '/private/home/hdheath/miniforge3/envs/isoseq'
    conda_stringtie = '/private/home/hdheath/miniforge3/envs/stringtie2'
    flames_sif     = '/private/groups/brookslab/hdheath/projects/flair-eval/envs/flames.sif'
}

// ---------------------------------------------------------------------------
// Profiles -- select execution environment
// ---------------------------------------------------------------------------
profiles {
    standard {
        // Default: SLURM execution on Phoenix cluster.
        // Heavy per-process resources are defined in this profile's process
        // scope so they don't leak into other profiles like fire_test.
        process.executor       = 'slurm'
        process.clusterOptions = '--partition=short'
        executor.queueSize     = 100
        executor.submitRateLimit = '20/1min'
        executor.pollInterval  = '30 sec'
        executor.exitReadTimeout = '30 min'

        conda.enabled          = true
        singularity.enabled    = true
        singularity.autoMounts = true

        process {
            withName: 'FlairAlign' {
                conda          = params.conda_flair
                cpus           = 4
                memory         = '96 GB'
                time           = '48h'
                clusterOptions = '--partition=long'
            }
            withName: 'FlairPartition' {
                conda          = params.conda_flair
                memory         = '12 GB'
                time           = '1h'
                clusterOptions = '--partition=short'
            }
            withName: 'FlairTranscriptome' {
                conda          = params.conda_flair
                cpus           = 12
                memory         = '64 GB'
                time           = '24h'
                clusterOptions = '--partition=long'
                beforeScript   = 'export OMP_NUM_THREADS=1'
                errorStrategy  = 'ignore'
            }
            withName: 'Evaluation' {
                memory         = '100 GB'
                time           = '24h'
                clusterOptions = '--partition=long'
                errorStrategy  = 'ignore'
            }
            withName: 'BambuAssembly' {
                conda          = params.conda_bambu
                memory         = '65 GB'
                time           = '6h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
            withName: 'IsoQuantAssembly' {
                conda          = params.conda_isoquant
                cpus           = 8
                memory         = '65 GB'
                time           = '24h'
                clusterOptions = '--partition=long'
                errorStrategy  = 'ignore'
            }
            withName: 'IsoSeqAssembly' {
                conda          = params.conda_isoseq
                cpus           = 4
                memory         = '65 GB'
                time           = '6h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
            withName: 'FlamesAssembly' {
                container      = params.flames_sif
                conda          = null
                cpus           = 4
                memory         = '65 GB'
                time           = '6h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
            withName: 'StringTie2Assembly' {
                conda          = params.conda_stringtie
                cpus           = 4
                memory         = '65 GB'
                time           = '6h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
            withName: 'CumulativeSignalPlot|EndSignalScatterPlot' {
                memory         = '16 GB'
                time           = '2h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
            withName: 'EndSignalHeatmap|ReadEndHeatmap|ReadEndSignalScatter' {
                memory         = '64 GB'
                time           = '6h'
                clusterOptions = '--partition=medium'
                errorStrategy  = 'ignore'
            }
        }
    }
    local {
        // Local execution (for development / small tests)
        process.executor = 'local'
        conda.enabled    = true
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    fire_test {
        // Single-chromosome / quick-iteration profile.
        // Large files (work dir, assembly intermediates) go to /private/groups to spare home quota.
        // Plots and reports stay in params.outdir (defaults to results/ under home).
        process.executor       = 'slurm'
        process.clusterOptions = '--partition=short'
        executor.queueSize     = 100
        executor.submitRateLimit = '20/1min'
        executor.pollInterval  = '30 sec'
        executor.exitReadTimeout = '5 min'

        conda.enabled          = true
        singularity.enabled    = true
        singularity.autoMounts = true

        // Route Nextflow work dir to groups storage
        workDir = '/private/groups/brookslab/hdheath/results/flair4/work'

        // Tightened resource requests based on actual chr22 trace data:
        //   FlairTranscriptome: 7-25 min observed, ~12 GB RSS
        //   IsoQuantAssembly:   6-11 min observed,  ~4 GB RSS
        //   Evaluation:         <2 min observed,     ~2 GB RSS
        process {
            scratch = '/data/tmp'
            withName: 'FlairAlign' {
                conda          = params.conda_flair
                cpus           = 4
                memory         = '32 GB'
                time           = '45m'
                clusterOptions = '--partition=short'
            }
            withName: 'FlairPartition' {
                conda          = params.conda_flair
                memory         = '8 GB'
                time           = '15m'
                clusterOptions = '--partition=short'
            }
            withName: 'FlairTranscriptome' {
                conda          = params.conda_flair
                cpus           = 3
                memory         = '30 GB'
                time           = '45m'
                clusterOptions = '--partition=short'
                beforeScript   = 'export OMP_NUM_THREADS=1'
                errorStrategy  = 'ignore'
            }
            withName: 'IsoQuantAssembly' {
                conda          = params.conda_isoquant
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'BambuAssembly' {
                conda          = params.conda_bambu
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'IsoSeqAssembly' {
                conda          = params.conda_isoseq
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'StringTie2Assembly' {
                conda          = params.conda_stringtie
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'FlamesAssembly' {
                container      = params.flames_sif
                conda          = null
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'Evaluation' {
                memory         = '4 GB'
                time           = '15m'
                clusterOptions = '--partition=short'
            }
        }
    }
    test {
        // Very small SLURM smoke-test profile for narrow regional runs
        // such as data/5_1_26.{csv,json}.  Keeps requests below fire_test
        // while retaining enough headroom for FLAIR/TED startup overhead.
        process.executor       = 'slurm'
        process.clusterOptions = '--partition=short'
        executor.queueSize     = 25
        executor.submitRateLimit = '10/1min'
        executor.pollInterval  = '20 sec'
        executor.exitReadTimeout = '5 min'

        conda.enabled          = true
        singularity.enabled    = true
        singularity.autoMounts = true
        params.lightweight_test_profile = true

        // Keep even small test intermediates off home quota. This mirrors the
        // fire_test storage pattern while keeping test-profile cache separate.
        workDir = '/private/groups/brookslab/hdheath/results/flair4/test_work'

        process {
            scratch = '/data/tmp'
            cpus    = 1
            memory  = '2 GB'
            time    = '15m'
            clusterOptions = '--partition=short'

            withName: 'FlairAlign' {
                conda          = params.conda_flair
                cpus           = 2
                memory         = '12 GB'
                time           = '30m'
            }
            withName: 'FlairPartition' {
                conda          = params.conda_flair
                memory         = '4 GB'
                time           = '10m'
            }
            withName: 'FlairTranscriptome' {
                conda          = params.conda_flair
                cpus           = 2
                memory         = '16 GB'
                time           = '30m'
                beforeScript   = 'export OMP_NUM_THREADS=1'
                errorStrategy  = 'ignore'
            }
            withName: 'Evaluation' {
                memory         = '4 GB'
                time           = '10m'
                errorStrategy  = 'ignore'
            }
            withName: 'PrepareReferencePeaks|TedEndPrecision|FirstpassComparison|CombineEvaluationTSVs|CombinePrecisionRecall|CombineGtfPrecisionRecall' {
                memory         = '2 GB'
                time           = '10m'
            }
            withName: 'SummaryPlots|PrecisionRecallPlot|PeakReasonHeatmap|SignalSupportDashboard|PeakRocCurves|CrossSamplePeakRoc|CrossSampleCellLinePrecisionPanel' {
                memory         = '3 GB'
                time           = '15m'
                errorStrategy  = 'ignore'
            }
            withName: 'IsoformsPerGeneHist|ExonLengthDistributionPlot|JaccardHeatmapPlot|TotalIsoformsPlot|TpOverlapPlot|GeneVariationPlot|SjcEndDistancePlot|EndSignalMetaplot|InternalPrimingAnalysis|GeneRecoveryAnalysis|AltEndCDSAnalysis|CDSCoverageRecovery|DroppedGeneCharacterization' {
                memory         = '3 GB'
                time           = '15m'
                errorStrategy  = 'ignore'
            }
            withName: 'CumulativeSignalPlot|EndSignalScatterPlot|ReadEndSignalScatter|SignalReadSupport|PrSignalBalance|SqantiPrecision|DepthCalibration|ClusterSpreadPlots|TedLogAnalysis|SjcAltEndAnalysis|TedComponentDiagnostic|IsoformEndRoc|TedScoreVsSignal' {
                memory         = '4 GB'
                time           = '20m'
                errorStrategy  = 'ignore'
            }
            withName: 'EndSignalHeatmap|ReadEndHeatmap|TedRejectionAnalysis|TedConfusionMatrix' {
                memory         = '6 GB'
                time           = '20m'
                errorStrategy  = 'ignore'
            }
            withName: 'BambuAssembly|IsoQuantAssembly|IsoSeqAssembly|FlamesAssembly|StringTie2Assembly' {
                memory         = '6 GB'
                time           = '20m'
                errorStrategy  = 'ignore'
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    // Base defaults for all processes.
    // Heavy per-process resources for the full-genome workflow live inside
    // the `standard` profile (above) so that lighter profiles like
    // `fire_test` can override without a precedence battle.  Settings here
    // are common to every profile.
    executor    = 'slurm'
    scratch     = '/data/tmp'
    time        = '1h'
    memory      = '8 GB'
    conda       = params.conda_analysis
    stageInMode = 'symlink'

    withName: 'PrepareReferencePeaks' {
        time     = params.lightweight_test_profile ? '10m' : '30m'
    }

    // -- Visualization & summary (lightweight, common defaults) ----------

    withName: 'SummaryPlots|PeakReasonHeatmap|SignalSupportDashboard|IsoformDiversity' {
        memory         = params.lightweight_test_profile ? '3 GB' : '4 GB'
        time           = params.lightweight_test_profile ? '15m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'IsoformsPerGeneHist|ExonLengthDistributionPlot|JaccardHeatmapPlot|TotalIsoformsPlot|TpOverlapPlot|GeneVariationPlot|SjcEndDistancePlot|EndSignalMetaplot|GeneRecoveryAnalysis|AltEndCDSAnalysis|CDSCoverageRecovery|DroppedGeneCharacterization' {
        memory         = params.lightweight_test_profile ? '3 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '15m' : '45m'
        clusterOptions = '--partition=short'
        errorStrategy  = 'ignore'
    }

    withName: 'InternalPrimingAnalysis' {
        memory         = params.lightweight_test_profile ? '3 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '15m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'SignalReadSupport|PrSignalBalance' {
        memory         = params.lightweight_test_profile ? '4 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '20m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'SqantiPrecision|DepthCalibration' {
        memory         = params.lightweight_test_profile ? '3 GB' : '4 GB'
        time           = '15m'
        clusterOptions = '--partition=short'
    }

    withName: 'ClusterSpreadPlots|TedLogAnalysis' {
        memory         = params.lightweight_test_profile ? '4 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '20m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'SjcAltEndAnalysis|TedComponentDiagnostic|IsoformEndRoc|TedScoreVsSignal' {
        memory         = params.lightweight_test_profile ? '4 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '20m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'TedRejectionAnalysis' {
        memory         = params.lightweight_test_profile ? '6 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '20m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'PrecisionRecallPlot' {
        memory         = params.lightweight_test_profile ? '3 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '15m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'CrossSamplePrecisionRecall|CrossSampleConcordance|CrossSampleSignalSupport|CrossSampleLandscape|CrossSampleToolEndAccuracy|CrossSampleCellLinePrecisionPanel' {
        memory         = params.lightweight_test_profile ? '3 GB' : '4 GB'
        time           = params.lightweight_test_profile ? '15m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'PeakRocCurves|CrossSamplePeakRoc' {
        memory         = params.lightweight_test_profile ? '3 GB' : '8 GB'
        time           = params.lightweight_test_profile ? '15m' : '30m'
        clusterOptions = '--partition=short'
    }

    withName: 'CombineEvaluationTSVs|CombinePrecisionRecall|TedEndPrecision|FirstpassComparison|CombineGtfPrecisionRecall' {
        memory         = params.lightweight_test_profile ? '2 GB' : '4 GB'
        time           = params.lightweight_test_profile ? '10m' : '30m'
        clusterOptions = '--partition=short'
    }

}

// ---------------------------------------------------------------------------
// Work directory (global default -- fire_test profile overrides this)
// Large intermediate files go to /private/groups to avoid home quota (100 GB).
// ---------------------------------------------------------------------------
workDir = '/private/groups/brookslab/hdheath/results/flair4/work'

// ---------------------------------------------------------------------------
// Enable conda (default -- profiles may override)
// ---------------------------------------------------------------------------
conda {
    enabled = true
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
trace {
    enabled   = true
    file      = "${params.outdir}/reports/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,workdir'
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}
