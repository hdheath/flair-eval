// =============================================================================
// Nextflow configuration for FLAIR evaluation pipeline
// =============================================================================

// Pipeline metadata
manifest {
    name            = 'brookslab/flair-eval'
    author          = 'Brooks Lab'
    description     = 'Evaluation pipeline for long-read RNA-seq isoform assemblers'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// ---------------------------------------------------------------------------
// Global parameters
// ---------------------------------------------------------------------------
params {
    // Required inputs
    input       = null   // Samplesheet CSV with dataset definitions
    params_file = null   // JSON config with align/partition/transcriptome mode parameters
    test_name   = 'flair_test_suite'  // Test name for output organization
    outdir      = "results/${params.test_name}" // Base output directory (grouped by test_name)

    // Feature flags
    run_firstpass_comparison = false  // Set to true to enable firstpass vs final end-precision comparison

    // Optional files for partition process
    cage_peaks     = null
    drna_peaks = null
    junctions      = null
    target_regions = null

    // Conda environment paths -- override via -profile or command-line
    conda_flair    = '/private/home/hdheath/miniforge3/envs/flair4'
    conda_analysis = '/private/home/hdheath/miniforge3/envs/nextflow_env'
    conda_bambu    = '/private/home/hdheath/miniforge3/envs/bambu'
    conda_isoquant = '/private/home/hdheath/miniforge3/envs/isoquant'
    conda_isoseq   = '/private/home/hdheath/miniforge3/envs/isoseq'
    conda_stringtie = '/private/home/hdheath/miniforge3/envs/stringtie2'
    flames_sif     = '/private/groups/brookslab/hdheath/projects/flair-eval/envs/flames.sif'
}

// ---------------------------------------------------------------------------
// Profiles -- select execution environment
// ---------------------------------------------------------------------------
profiles {
    standard {
        // Default: SLURM execution on Phoenix cluster
        process.executor       = 'slurm'
        process.clusterOptions = '--partition=short'
        executor.queueSize     = 100
        executor.submitRateLimit = '20/1min'
        executor.pollInterval  = '30 sec'
        executor.exitReadTimeout = '5 min'

        conda.enabled          = true
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    local {
        // Local execution (for development / small tests)
        process.executor = 'local'
        conda.enabled    = true
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    fire_test {
        // Single-chromosome / quick-iteration profile.
        // Large files (work dir, assembly intermediates) go to /private/groups to spare home quota.
        // Plots and reports stay in params.outdir (defaults to results/ under home).
        process.executor       = 'slurm'
        process.clusterOptions = '--partition=short'
        executor.queueSize     = 100
        executor.submitRateLimit = '20/1min'
        executor.pollInterval  = '30 sec'
        executor.exitReadTimeout = '5 min'

        conda.enabled          = true
        singularity.enabled    = true
        singularity.autoMounts = true

        // Route Nextflow work dir to groups storage
        workDir = '/private/groups/brookslab/hdheath/results/flair4/work'

        // Tightened resource requests based on actual chr22 trace data:
        //   FlairTranscriptome: 7-25 min observed, ~12 GB RSS
        //   IsoQuantAssembly:   6-11 min observed,  ~4 GB RSS
        //   Evaluation:         <2 min observed,     ~2 GB RSS
        process {
            scratch = '/data/tmp'
            withName: 'FlairTranscriptome' {
                cpus           = 2
                memory         = '16 GB'
                time           = '45m'
                clusterOptions = '--partition=short'
                beforeScript   = 'export OMP_NUM_THREADS=1'
            }
            withName: 'IsoQuantAssembly' {
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'BambuAssembly' {
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'IsoSeqAssembly' {
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'StringTie2Assembly' {
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'FlamesAssembly' {
                container      = params.flames_sif
                conda          = null
                cpus           = 4
                memory         = '8 GB'
                time           = '30m'
                clusterOptions = '--partition=short'
            }
            withName: 'Evaluation' {
                memory         = '4 GB'
                time           = '15m'
                clusterOptions = '--partition=short'
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    // Base defaults for all processes
    executor    = 'slurm'
    scratch     = '/data/tmp'
    time        = '1h'
    memory      = '8 GB'
    conda       = params.conda_analysis
    stageInMode = 'symlink'

    // -- Core pipeline ---------------------------------------------------

    withName: 'FlairAlign' {
        conda          = params.conda_flair
        cpus           = 4
        memory         = '96 GB'
        time           = '48h'
        clusterOptions = '--partition=long'
    }

    withName: 'FlairPartition' {
        conda    = params.conda_flair
        memory   = '12 GB'
    }

    withName: 'FlairTranscriptome' {
        conda        = params.conda_flair
        cpus         = 2
        memory       = '30 GB'
        time         = '1h'
        // clusterOptions intentionally omitted here — set per-profile:
        //   standard  → process.clusterOptions = '--partition=short' (profile default)
        //   fire_test → withName block sets '--partition=short'
        // Prevent OpenMP thread-pool deadlock in forked XGBoost workers
        beforeScript = 'export OMP_NUM_THREADS=1'
    }

    withName: 'Evaluation' {
        memory   = '10 GB'
        time     = '1h'
        clusterOptions = '--partition=short'
    }

    // -- Alternative assemblers -----------------------------------------

    withName: 'BambuAssembly' {
        conda    = params.conda_bambu
        memory   = '20 GB'
        time     = '1h'
        clusterOptions = '--partition=short'
    }

    withName: 'IsoQuantAssembly' {
        conda    = params.conda_isoquant
        memory   = '20 GB'
        time     = '1h'
        clusterOptions = '--partition=short'
    }

    withName: 'IsoSeqAssembly' {
        conda    = params.conda_isoseq
        cpus     = 4
        memory   = '20 GB'
        time     = '1h'
        clusterOptions = '--partition=short'
    }

    withName: 'FlamesAssembly' {
        // FLAMES runs via Nextflow's native Singularity support
        container = params.flames_sif
        conda     = null
        cpus      = 4
        memory    = '20 GB'
        time      = '1h'
        clusterOptions = '--partition=short'
    }

    withName: 'StringTie2Assembly' {
        conda    = params.conda_stringtie
        cpus     = 4
        memory   = '20 GB'
        time     = '1h'
        clusterOptions = '--partition=short'
    }

    withName: 'PrepareReferencePeaks' {
        time     = '30m'
    }

    // -- Visualization & summary ----------------------------------------

    withName: 'SummaryPlots|PeakReasonHeatmap|SignalSupportDashboard|IsoformDiversity' {
        memory   = '4 GB'
    }

    withName: 'CumulativeSignalPlot|EndSignalScatterPlot|IsoformsPerGeneHist|JaccardHeatmapPlot|TotalIsoformsPlot|TpOverlapPlot|GeneVariationPlot|SjcEndDistancePlot|ReadEndSignalScatter' {
        memory   = '8 GB'
    }

    withName: 'CrossSamplePrecisionRecall|CrossSampleConcordance|CrossSampleSignalSupport|CrossSampleLandscape|CrossSampleToolEndAccuracy' {
        memory   = '4 GB'
    }

    withName: 'PeakRocCurves|CrossSamplePeakRoc' {
        memory   = '8 GB'
    }

    withName: 'CombineEvaluationTSVs|CombinePrecisionRecall|TedEndPrecision|FirstpassComparison' {
        memory   = '4 GB'
    }

}

// ---------------------------------------------------------------------------
// Work directory (global default -- fire_test profile overrides this)
// Large intermediate files go to /private/groups to avoid home quota (100 GB).
// ---------------------------------------------------------------------------
workDir = '/private/groups/brookslab/hdheath/results/flair4/work'

// ---------------------------------------------------------------------------
// Enable conda (default -- profiles may override)
// ---------------------------------------------------------------------------
conda {
    enabled = true
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
trace {
    enabled   = true
    file      = "${params.outdir}/reports/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,workdir'
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/reports/execution_timeline.html"
    overwrite = true
}
