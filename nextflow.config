/*
 * flair-eval v2: compare FLAIR runs (versions, branches, settings) on the same data.
 * Param names and defaults are fixed by docs/CONTRACTS.md section 1.
 */

manifest {
    name            = 'hdheath/flair-eval'
    description     = 'Compare FLAIR runs (versions, branches or settings) on the same long-read data'
    homePage        = 'https://github.com/hdheath/flair-eval'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '2.0.0dev'
}

plugins {
    id 'nf-schema@2.5.1'
}

params {
    // file mode
    input          = null
    runs           = null
    // one-command mode
    reads          = null
    bam            = null
    genome         = null
    gtf            = null
    sample         = null
    platform       = null
    library        = null
    flair          = null
    flair_args     = ''
    // outputs and report
    outdir         = null       // required; on phoenix put it on groups or warm-archive storage
    bundles        = null
    baseline       = null
    report_only    = false
    report_title   = 'FLAIR comparison'
    // compute
    align_flair    = '3.0.1'
    regions        = null
    env_cache      = "${launchDir}/flair-env-cache"   // phoenix: the shared lab cache
    // --genome <key>: lab reference presets on phoenix (fills --genome and, if not given, --gtf)
    genomes        = [
        hg38: [
            fasta: '/private/groups/brookslab/reference_sequence/GRCh38.primary_assembly.genome.fa',
            gtf  : '/private/groups/brookslab/reference_annotations/gencode.v49.basic.annotation.gtf',
            note : 'GRCh38 primary assembly + GENCODE v49 basic'
        ]
    ]
    // help
    help           = false
}

// Thread caps for every task. Without them FLAIR byregion runs can deadlock in BLAS/xgboost threads.
env {
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    XGBOOST_NTHREAD      = '1'
    NUMEXPR_NUM_THREADS  = '1'
    PYTHONUNBUFFERED     = '1'
}

// BUNDLE ships its helper script in modules/bundle/resources/usr/bin/.
nextflow.enable.moduleBinaries = true

// FLAIR envs resolved by FLAIR_ENV are conda prefixes or containers (CONTRACTS section 2).
// FLAIR tasks always put a run's conda_prefix/bin first on PATH; with -profile conda the
// prefix is also activated through the conda directive. Container runs need
// -profile docker or singularity.
conda.enabled = false

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // No -profile = phoenix (UCSC PRISM): SLURM, conda and the shared env cache.
    standard {
        includeConfig 'conf/phoenix.config'
    }
    phoenix {
        includeConfig 'conf/phoenix.config'
    }
    local {
        process.executor = 'local'
        // Cap every request at this machine's size so laptops and 4-core CI runners can run the
        // defaults (otherwise "Process requirement exceeds available CPUs").
        process.resourceLimits = [
            cpus  : Runtime.runtime.availableProcessors(),
            memory: new nextflow.util.MemoryUnit(java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize())
        ]
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }
    docker {
        docker.enabled      = true
        singularity.enabled = false
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

trace {
    enabled   = params.outdir != null
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,time,workdir'
}
report {
    enabled   = params.outdir != null
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled   = params.outdir != null
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
