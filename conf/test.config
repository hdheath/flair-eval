/*
 * -profile test: a tiny human region (hg38 chr19:1-2,000,000, GENCODE v49 basic, 20k WTC11 PacBio
 * and 20k ONT reads) with FLAIR 3.0.1, 2.2.0 and dev. Provenance: docs/test_data.md.
 * Combine with an executor profile, e.g. `-profile test,phoenix` or `-profile test,local`.
 */
params {
    input        = "${projectDir}/tests/data/test_samples.csv"
    runs         = "${projectDir}/tests/data/test_runs.yaml"
    regions      = "${projectDir}/tests/data/test_regions.bed"
    // A26: refTSS / PolyA_DB cut to the test window (hg38 coordinates) + the TUSCO list
    // (tests/data/build_test_refs.sh); the test genome is a custom file, so no preset fills them
    ref_tss      = "${projectDir}/tests/data/human_region/human_region.refTSS.bed"
    ref_pas      = "${projectDir}/tests/data/human_region/human_region.polyA_DB.bed"
    tusco        = "${projectDir}/tests/data/human_region/human_region.tusco.tsv"
    report_title = 'FLAIR comparison (test data)'
}

process {
    resourceLimits = [cpus: 4, memory: 16.GB, time: 1.h]
}
