/*
 * -profile test: tiny human region + SIRV sets made by the testdata stream.
 * Combine with an executor profile, e.g. `-profile test,local` or `-profile test,phoenix`.
 */
params {
    // TODO(testdata stream): these files are created on branch v2-testdata. Until that branch is
    // merged they are absent and input checking stops with a clear "file not found" error.
    input        = "${projectDir}/tests/data/test_samples.csv"
    runs         = "${projectDir}/tests/data/test_runs.yaml"
    // TODO(testdata stream): set to the regions BED once tests/data/ names it.
    regions      = null
    report_title = 'FLAIR comparison (test data)'
}

process {
    resourceLimits = [cpus: 4, memory: 16.GB, time: 1.h]
}
