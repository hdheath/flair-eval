/*
 * Where outputs are published (CONTRACTS section 5):
 *   <outdir>/bundles/<sample>/<run_id>/...   BUNDLE
 *   <outdir>/report/report.html              REPORT
 *   <outdir>/pipeline_info/...               nextflow.config (trace/report/timeline) + main.nf (params.json)
 * Intermediate FLAIR outputs stay in the work directory; the bundle keeps what the report needs.
 */
process {
    withName: 'BUNDLE' {
        publishDir = [
            [path: { "${params.outdir}/bundles/${meta.sample}" }, mode: 'copy'],
        ]
    }
    withName: 'REPORT' {
        publishDir = [
            [path: { "${params.outdir}/report" }, mode: 'copy', pattern: 'report.html'],
        ]
    }
}
