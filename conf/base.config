/*
 * Default resources. Labels follow nf-core naming. conf/slurm.config right-sizes them for PRISM.
 * Memory and time grow with task.attempt; one retry on out-of-memory / time-limit exits.
 */
process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    // FLAIR_ENV (A11): builds or checks a FLAIR env on the host/base env, never inside one.
    // Needs network, git and mamba/conda. A cold build takes ~5-15 min.
    withLabel: flair_env {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // Non-FLAIR steps: stdlib + pandas/numpy (CONTRACTS section 6). Each directive only takes
    // effect when its engine is on (-profile conda | docker | singularity); otherwise the host
    // python3 is used.
    withName: 'EVALUATE_STRUCTURE|BUNDLE|REPORT' {
        conda     = "${projectDir}/modules/evaluate_structure/environment.yml"
        container = 'quay.io/biocontainers/pandas:2.2.1'
    }
}
