/*
 * PRISM (UCSC) SLURM profile. Partitions: short (<=1 h), medium (<=12 h), long (<=14 d).
 * The partition is picked from each task's time request.
 *
 * Sizes come from measured use: on 2026-08 A549 PacBio cDNA (3 main chromosomes), FLAIR 3
 * transcriptome peaked at 9.7 GB RSS, used ~5 of 12 CPUs on average, and took ~2 h.
 * Whole-genome jobs need more time; the retry doubles memory and time once.
 *
 * Nothing here points at PRISM storage. Pass --outdir, -work-dir and --env_cache on groups /
 * warm-archive storage yourself (home quota is ~100 GB).
 */
executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '10 min'
}

process {
    executor = 'slurm'
    queue    = { task.time <= 1.h ? 'short' : (task.time <= 12.h ? 'medium' : 'long') }

    withLabel: flair_env {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'ALIGN.*' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'ASSEMBLE' {
        cpus   = 12
        memory = { 24.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'QUANTIFY' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'PRODUCTIVITY' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'EVALUATE_STRUCTURE' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'BUNDLE|REPORT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
