/*
 * phoenix (UCSC PRISM): the default profile, used when no -profile is given.
 * SLURM (conf/slurm.config) + conda + the shared lab FLAIR env cache.
 *
 * Every user passes their own --outdir (groups or warm-archive storage; home is too small).
 * Nextflow's work dir goes inside it unless -work-dir is given.
 */
includeConfig 'slurm.config'

conda.enabled       = true
// Nextflow's own small envs (evaluation, report) are shared by the lab too. Launch with umask 002
// (flair-eval run does) so others can take the build locks.
conda.cacheDir      = '/private/groups/brookslab/flair-eval/conda_cache'
docker.enabled      = false
singularity.enabled = false

params {
    // One cache for the whole lab: a release builds once for everyone, a dev commit once per SHA.
    // flair_env.py locks each build and keeps the tree group-writable.
    env_cache = '/private/groups/brookslab/flair-eval/env_cache'
}

// Without --outdir the run stops at once; 'work' then avoids a stray 'null/work' folder.
workDir = params.outdir ? "${params.outdir}/work" : 'work'
